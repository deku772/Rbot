<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Rbot dark dialog: use Material Components base so buttons render correctly -->
    <style name="TermuxAlertDialogStyle" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <!-- Dialog window -->
        <item name="android:windowBackground">@color/rbot_surface</item>
        <item name="android:backgroundDimEnabled">true</item>
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/rbot_on_background</item>
        <item name="android:textColorSecondary">@color/rbot_secondary_text</item>
        <!-- Accent color -->
        <item name="colorAccent">@color/rbot_accent</item>
        <!-- List item text -->
        <item name="textColorAlertDialogListItem">@color/rbot_on_background</item>
        <!-- Button bar -->
        <item name="buttonBarPositiveButtonStyle">@style/Rbot.Dialog.Button.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Rbot.Dialog.Button</item>
        <item name="buttonBarNeutralButtonStyle">@style/Rbot.Dialog.Button</item>
    </style>

    <!-- Accent-colored positive button (Confirm / 确认) -->
    <style name="Rbot.Dialog.Button.Positive" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/rbot_accent</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Neutral / cancel button -->
    <style name="Rbot.Dialog.Button" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/rbot_secondary_text</item>
    </style>

    <style name="TermuxActivity.Drawer.ButtonBarStyle.Light" parent="@style/Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/rbot_on_background</item>
    </style>

    <style name="TermuxActivity.Drawer.ButtonBarStyle.Dark" parent="@style/Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/rbot_on_background</item>
        <item name="rippleColor">@color/rbot_accent</item>
    </style>

    <style name="RbotChannelTabText">
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="RbotChannelOpenSetupLink">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/rbot_accent</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="RbotChannelActionButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">12dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- BaseToolbar Title text appearance (from termux-shared) -->
    <style name="TextAppearance.Widget.BaseToolbar.Title" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">14sp</item>
    </style>

    <!-- BaseToolbar Subtitle text appearance (from termux-shared) -->
    <style name="TextAppearance.Widget.BaseToolbar.Subtitle" parent="TextAppearance.Widget.AppCompat.Toolbar.Subtitle">
        <item name="android:textSize">12sp</item>
    </style>

</resources>
