<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rbot_background"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/hermes_scroll_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageButton
                android:id="@+id/btn_hermes_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="返回"
                android:padding="8dp" />

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/rbot_logo"
                android:contentDescription="Hermes" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hermes Agent"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/rbot_on_background" />
                <TextView
                    android:id="@+id/tv_hermes_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="检查中..."
                    android:textSize="12sp"
                    android:textColor="@color/rbot_secondary_text" />
            </LinearLayout>

            <View
                android:id="@+id/dot_hermes_status"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/ic_status_not_ready" />
        </LinearLayout>

        <!-- Platform Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rbot_card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="支持的消息平台"
                android:textSize="12sp"
                android:textColor="@color/rbot_secondary_text"
                android:layout_marginBottom="6dp" />
            <TextView
                android:id="@+id/tv_hermes_platforms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Telegram · Discord · 钉钉 · 飞书 · 企业微信 · Slack"
                android:textSize="13sp"
                android:textColor="@color/rbot_accent" />
        </LinearLayout>

        <!-- Control Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <Button
                android:id="@+id/btn_hermes_start"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="启动"
                android:textSize="14sp"
                android:background="@drawable/rbot_button_green_bg"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />
            <Button
                android:id="@+id/btn_hermes_stop"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="停止"
                android:textSize="14sp"
                android:background="@drawable/rbot_button_bg"
                android:textColor="#1A1A1A"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp" />
            <Button
                android:id="@+id/btn_hermes_restart"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="重启"
                android:textSize="14sp"
                android:background="@drawable/rbot_button_outline_bg"
                android:textColor="@color/rbot_accent"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Log + Shell -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <Button
                android:id="@+id/btn_view_log"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="📄 运行日志"
                android:textSize="13sp"
                android:background="@drawable/rbot_button_outline_bg"
                android:textColor="@color/rbot_accent"
                android:layout_marginEnd="6dp" />
            <Button
                android:id="@+id/btn_ssh"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="🔐 SSH 终端"
                android:textSize="13sp"
                android:background="@drawable/rbot_button_outline_bg"
                android:textColor="@color/rbot_accent"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- SSH Connection Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rbot_card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SSH 连接信息"
                android:textSize="12sp"
                android:textColor="@color/rbot_secondary_text"
                android:layout_marginBottom="8dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本机连接（推荐）"
                android:textSize="11sp"
                android:textColor="#666666"
                android:layout_marginBottom="2dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <TextView
                    android:id="@+id/tv_ssh_local_cmd"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ssh root@127.0.0.1 -p 8022"
                    android:textSize="12sp"
                    android:textColor="@color/rbot_accent"
                    android:fontFamily="monospace" />
                <Button
                    android:id="@+id/btn_copy_ssh_local"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="复制"
                    android:textSize="11sp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:background="@drawable/rbot_button_outline_bg"
                    android:textColor="@color/rbot_accent" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="局域网连接"
                android:textSize="11sp"
                android:textColor="#666666"
                android:layout_marginBottom="2dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tv_ssh_lan_cmd"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ssh root@192.168.x.x -p 8022"
                    android:textSize="12sp"
                    android:textColor="@color/rbot_accent"
                    android:fontFamily="monospace" />
                <Button
                    android:id="@+id/btn_copy_ssh_lan"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="复制"
                    android:textSize="11sp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:background="@drawable/rbot_button_outline_bg"
                    android:textColor="@color/rbot_accent" />
            </LinearLayout>
            <Button
                android:id="@+id/btn_reset_ssh_password"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="🔑 重置 SSH 密码"
                android:textSize="12sp"
                android:layout_marginTop="10dp"
                android:background="@drawable/rbot_button_outline_bg"
                android:textColor="@color/rbot_accent" />
        </LinearLayout>

        <!-- About Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rbot_card_bg"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="关于 Hermes Agent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/rbot_on_background"
                android:layout_marginBottom="6dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hermes Agent 是 NousResearch 开发的 AI Agent 框架，支持多平台接入（Telegram/Discord/钉钉/飞书/企业微信等）。"
                android:textSize="12sp"
                android:textColor="@color/rbot_secondary_text"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>