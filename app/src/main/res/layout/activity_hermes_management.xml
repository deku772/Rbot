<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/botdrop_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/botdrop_logo"
                android:contentDescription="Hermes" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hermes Agent"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/botdrop_on_background" />

                <TextView
                    android:id="@+id/tv_hermes_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="检查中..."
                    android:textSize="13sp"
                    android:textColor="@color/botdrop_secondary_text" />
            </LinearLayout>

            <View
                android:id="@+id/dot_hermes_status"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/ic_status_not_ready" />
        </LinearLayout>

        <!-- Hermes CLI 参考 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/botdrop_card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="访问 Hermes CLI"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/botdrop_on_background"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hermes Agent 不提供 Web 管理面板，所有配置通过 CLI 命令完成。使用上方「打开 Rbot 交互式终端」进入内置终端后，可执行以下常用命令："
                android:textSize="13sp"
                android:textColor="@color/botdrop_secondary_text"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="hermes doctor              # 环境诊断\nhermes config set KEY VALUE  # 非交互式设置\nhermes gateway setup        # 配置消息平台\nhermes gateway start         # 启动 Gateway\nhermes status                # 运行状态"
                android:textSize="12sp"
                android:textColor="@color/botdrop_accent"
                android:fontFamily="monospace"
                android:background="#0D000000"
                android:padding="10dp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- Access Instructions Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/botdrop_card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="交互式配置 (hermes setup)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/botdrop_on_background"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="hermes setup 需要交互式终端，无法在安装流程中自动完成。请使用以下方式进入交互式配置："
                android:textSize="13sp"
                android:textColor="@color/botdrop_secondary_text"
                android:layout_marginBottom="12dp" />

            <!-- Shell button -->
            <Button
                android:id="@+id/btn_open_shell"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="打开 Rbot 交互式终端 (推荐)"
                android:textSize="14sp"
                android:background="@drawable/botdrop_button_bg"
                android:textColor="#1A1A1A"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="进入终端后执行："
                android:textSize="12sp"
                android:textColor="@color/botdrop_secondary_text"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="cd /root/hermes-agent-src\nsource /root/hermes/venv/bin/activate\nhermes setup"
                android:textSize="12sp"
                android:textColor="@color/botdrop_accent"
                android:fontFamily="monospace"
                android:background="#0D000000"
                android:padding="10dp" />
        </LinearLayout>

        <!-- Control Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn_hermes_start"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="启动"
                android:textSize="13sp"
                android:background="@drawable/botdrop_button_green_bg"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_hermes_stop"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="停止"
                android:textSize="13sp"
                android:background="@drawable/botdrop_button_bg"
                android:textColor="#1A1A1A"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_hermes_restart"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="重启"
                android:textSize="13sp"
                android:background="@drawable/botdrop_button_outline_bg"
                android:textColor="@color/botdrop_accent"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Log viewer button -->
        <Button
            android:id="@+id/btn_view_log"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="📄 查看运行日志"
            android:textSize="13sp"
            android:background="@drawable/botdrop_button_outline_bg"
            android:textColor="@color/botdrop_accent"
            android:layout_marginBottom="16dp" />

        <!-- Hermes info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/botdrop_card_bg"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="关于 Hermes Agent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/botdrop_on_background"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hermes Agent 是 NousResearch 开发的 AI Agent 框架，支持多平台接入（Telegram/Discord/钉钉等）。与 AstrBot 不同，Hermes 不提供 Web 管理面板，需要通过 CLI 进行配置和管理。"
                android:textSize="12sp"
                android:textColor="@color/botdrop_secondary_text"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
