<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/rbot_background"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/rbot_logo"
            android:contentDescription="@string/application_name"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="权限"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/rbot_on_background" />

    </LinearLayout>

    <!-- ═══ 第1位：Root 权限 ═══ -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#F3E5F5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔑"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Root 权限"
                        android:textSize="15sp"
                        android:textColor="#6A1B9A"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/root_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="检测中..."
                        android:textSize="12sp"
                        android:textColor="#4A148C"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="rbot 需要 Root 权限来挂载 chroot 环境、启动 SSH 服务和管理系统资源。如果没有 Root，可以使用 Shizuku 授权（见下方）。"
                android:textSize="12sp"
                android:textColor="#4A148C"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- ═══ 第2位：Shizuku ═══ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/shizuku_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#E0F7FA">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shizuku 授权"
                        android:textSize="15sp"
                        android:textColor="#00695C"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/shizuku_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="检测中..."
                        android:textSize="12sp"
                        android:textColor="#004D40"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="没有 Root？安装 Shizuku 应用 + Sui（Magisk 模块），通过 Shizuku 赋予 Rbot 同等的 Root 权限。需要 Shizuku 以 Root 方式运行（ADB 模式权限不足，无法 chroot）。"
                android:textSize="12sp"
                android:textColor="#004D40"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btn_grant_shizuku"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:text="授予 Shizuku 权限"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/rbot_button_green_bg" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- ═══ 第3位：PRoot 免 Root ═══ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/proot_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#F1F8E9">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚀"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRoot 免 Root 模式"
                        android:textSize="15sp"
                        android:textColor="#33691E"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/proot_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="免 Root 运行 Linux 环境"
                        android:textSize="12sp"
                        android:textColor="#1B5E20"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PRoot 通过 ptrace 系统调用拦截模拟 chroot，无需 Root 权限即可运行完整的 Ubuntu 环境和 AstrBot。适合没有 Root 的设备，或 Shizuku ADB 模式用户。性能略低于 Root 模式。"
                android:textSize="12sp"
                android:textColor="#1B5E20"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btn_enable_proot"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:text="启用 PRoot 模式"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/rbot_button_green_bg" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- ═══ 第4位：存储权限 ═══ -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#E3F2FD">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📁"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="存储权限"
                        android:textSize="15sp"
                        android:textColor="#1565C0"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/storage_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="检测中..."
                        android:textSize="12sp"
                        android:textColor="#0D47A1"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="需要访问存储来读取 rootfs 镜像包、备份文件和日志。没有此权限将无法检测本地已下载的系统镜像。"
                android:textSize="12sp"
                android:textColor="#0D47A1"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btn_grant_storage"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:text="授予存储权限"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/rbot_button_green_bg" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- ═══ 第5位：通知权限（Android 13+） ═══ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/notification_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#E8F5E9">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔔"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="通知权限"
                        android:textSize="15sp"
                        android:textColor="#2E7D32"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/notification_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未授予"
                        android:textSize="12sp"
                        android:textColor="#1B5E20"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Android 13+ 需要通知权限才能显示前台服务通知（AstrBot 运行状态）。"
                android:textSize="12sp"
                android:textColor="#1B5E20"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btn_grant_notification"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:text="授予通知权限"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/rbot_button_green_bg" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- ═══ 最后：电池优化（可选） ═══ -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFF3E0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔋"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="电池优化（可选）"
                        android:textSize="15sp"
                        android:textColor="#E65100"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/battery_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="检测中..."
                        android:textSize="12sp"
                        android:textColor="#BF360C"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="关闭电池优化可防止系统后台杀掉 AstrBot 服务。非必须，但推荐设置。"
                android:textSize="12sp"
                android:textColor="#BF360C"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btn_disable_battery_opt"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:text="优化电池设置"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/rbot_button_green_bg" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>