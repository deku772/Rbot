<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rbot_background"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/rbot_logo"
            android:contentDescription="@string/application_name"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="权限"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/rbot_on_background" />

    </LinearLayout>

    <!-- ═══ 第1位：Root 权限 ═══ -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#F3E5F5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔑"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Root 权限"
                        android:textSize="15sp"
                        android:textColor="#6A1B9A"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/root_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="检测中..."
                        android:textSize="12sp"
                        android:textColor="#4A148C"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="rbot 需要 Root 权限来挂载 chroot 环境、启动 SSH 服务和管理系统资源。如果没有 Root，可以使用 PRoot 免 Root 模式。"
                android:textSize="12sp"
                android:textColor="#4A148C"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>



    <!-- ═══ 第3位：存储权限 ═══ -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#E3F2FD">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📁"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="存储权限"
                        android:textSize="15sp"
                        android:textColor="#1565C0"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/storage_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="检测中..."
                        android:textSize="12sp"
                        android:textColor="#0D47A1"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="需要访问存储来读取 rootfs 镜像包、备份文件和日志。没有此权限将无法检测本地已下载的系统镜像。"
                android:textSize="12sp"
                android:textColor="#0D47A1"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btn_grant_storage"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:text="授予存储权限"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/rbot_button_green_bg" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- ═══ 第4位：安装模式选择 ═══ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/proot_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#F1F8E9">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚀"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="安装模式选择"
                        android:textSize="15sp"
                        android:textColor="#33691E"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/mode_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="请选择安装模式"
                        android:textSize="12sp"
                        android:textColor="#1B5E20"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="选择 AstrBot 的运行模式：\n• Chroot 模式：需要 Root 权限，性能最佳\n• PRoot 模式：无需 Root，通过 ptrace 模拟 chroot"
                android:textSize="12sp"
                android:textColor="#1B5E20"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btn_install_chroot"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Chroot 模式"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/rbot_button_green_bg" />

                <Button
                    android:id="@+id/btn_install_proot"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="PRoot 模式"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/rbot_button_green_bg" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- ═══ 第5位：通知权限（Android 13+） ═══ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/notification_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#E8F5E9">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔔"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="通知权限"
                        android:textSize="15sp"
                        android:textColor="#2E7D32"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/notification_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未授予"
                        android:textSize="12sp"
                        android:textColor="#1B5E20"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Android 13+ 需要通知权限才能显示前台服务通知（AstrBot 运行状态）。"
                android:textSize="12sp"
                android:textColor="#1B5E20"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btn_grant_notification"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:text="授予通知权限"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/rbot_button_green_bg" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- ═══ 最后：电池优化（可选） ═══ -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFF3E0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔋"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="电池优化（可选）"
                        android:textSize="15sp"
                        android:textColor="#E65100"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/battery_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="检测中..."
                        android:textSize="12sp"
                        android:textColor="#BF360C"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="关闭电池优化可防止系统后台杀掉 AstrBot 服务。非必须，但推荐设置。"
                android:textSize="12sp"
                android:textColor="#BF360C"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btn_disable_battery_opt"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:text="优化电池设置"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/rbot_button_green_bg" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- ═══ 安装入口 ═══ -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#1A3A1A">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📦 安装 AstrBot"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#8BC34A" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="权限配置完成后，点击下方按钮开始安装 AstrBot。安装过程需要下载系统镜像（约 458MB），请确保网络畅通。"
                android:textSize="12sp"
                android:textColor="#A5D6A7"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/btn_start_install"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:text="🚀 开始安装 AstrBot"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/rbot_button_green_bg" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>
</ScrollView>